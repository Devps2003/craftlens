{
  "name": "craftlens-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first engineering companion for AI-assisted coding",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run build -w @craftlens/panel-ui && npm run build -w craftlens",
    "package": "npm run build && npm run package -w craftlens",
    "scan-secrets": "node scripts/scan-secrets.mjs",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vscode/vsce": "^3.5.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
